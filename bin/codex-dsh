#!/usr/bin/env bash
# =============================================================================
# bin/codex-dsh — the `dsh` proving-exec shim (DshAdapter's process wrapper).
#
# danus.codex.exec_cmd builds one uniform `codex exec` argv for every exec site
# (worker rounds, the verify service, the artifact renderers). When the operator
# selects the dsh backend (CODEX_BACKEND=dsh), danus.codex.resolve_bin() returns
# THIS shim, so the sites keep their exact argv while each call is translated
# into one DeepSeek Harness headless session:
#
#   dsh --profile headless "<task>"
#
# Translation contract (see danus/codex.py + ARCHITECTURE.md):
#   - flags the codex CLI understands but headless has no direct equivalent are
#     dropped: -C <dir> (callers already set the process cwd), -c <mcp>,
#     --skip-git-repo-check, --add-dir <dir>, --config <non-effort toggles>
#   - --sandbox read-only|workspace-write is mapped to DSH_PERMISSION_MODE;
#     approval_policy="never" is accepted; legacy full-access/full-auto requests
#     are downgraded to workspace-write rather than honored
#   - DSH_TOOLS_MODE is forced to native because Code Mode's run_code path is not
#     covered by the current DSH file-effect sandbox
#   - the remaining positional arg is the task; a `-` sentinel means the task
#     arrives on stdin (the authoring driver's prompt)
#   - --model / --config model_reasoning_effort="E" are honored when they name
#     a deepseek-ish model / known effort; otherwise the deployment's dsh
#     settings win (settings.yaml of ${DANUS_DSH_HOME:-$HOME/.dsh})
#   - each run gets its own DSH_HOME under $DANUS_RUNTIME/dsh-runs/ (credentials
#     + settings copied from the deployment home, model/effort overridden per
#     call). The directory is reclaimed on EXIT. SIGKILL cannot run traps, so
#     a hard kill can still leave a home; SIGTERM/INT kill the child then reclaim.
#   - stdout = the headless session's final answer (what `codex exec` prints);
#     exit code passes through unchanged (0 = completed, non-zero = failure)
# =============================================================================
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$HERE/../scripts/env.sh" >/dev/null 2>&1 || true
DSH_PY="$HERE/../danus/dsh.py"
PY="${DANUS_PY:-python3}"

if [ -z "${DANUS_DSH_BIN:-}" ] || [ ! -f "${DANUS_DSH_BIN}" ]; then
  echo "[codex-dsh] dsh not provisioned — run scripts/setup-dsh.sh (sets DANUS_DSH_BIN)" >&2
  exit 127
fi

# --- parse the uniform codex argv -------------------------------------------
model_arg=""
effort_arg=""
sandbox_arg=""
approval_arg=""
use_stdin=0
task_args=()
while [ $# -gt 0 ]; do
  case "$1" in
    exec) shift ;;
    --model) model_arg="${2:-}"; shift 2 ;;
    --config)
      case "${2:-}" in
        model_reasoning_effort=*)
          effort_arg="${2#model_reasoning_effort=}"
          effort_arg="${effort_arg%\"}"
          effort_arg="${effort_arg#\"}"
          ;;
        approval_policy=*)
          approval_arg="${2#approval_policy=}"
          approval_arg="${approval_arg%\"}"
          approval_arg="${approval_arg#\"}"
          approval_arg="${approval_arg%\'}"
          approval_arg="${approval_arg#\'}"
          ;;
        *) ;;
      esac
      shift 2 ;;
    -C) shift 2 ;;
    -c) mcp_arg="${2:-}"; shift 2 ;;
    --skip-git-repo-check) shift ;;
    --add-dir) shift 2 ;;
    --sandbox) sandbox_arg="${2:-}"; shift 2 ;;
    --ask-for-approval) approval_arg="${2:-}"; shift 2 ;;
    --dangerously-bypass-approvals-and-sandbox|--full-auto)
      sandbox_arg="${sandbox_arg:-workspace-write}"
      shift
      ;;
    --) shift; task_args+=("$@"); break ;;
    -) use_stdin=1; shift ;;
    -*) echo "[codex-dsh] unsupported codex flag: $1" >&2; exit 2 ;;
    *) task_args+=("$1"); shift ;;
  esac
done

sandbox_arg="${sandbox_arg:-workspace-write}"
case "$sandbox_arg" in
  read-only|workspace-write) ;;
  *) echo "[codex-dsh] unsafe sandbox mode refused: $sandbox_arg" >&2; exit 126 ;;
esac
if [ -n "$approval_arg" ] && [ "$approval_arg" != "never" ]; then
  echo "[codex-dsh] approval escalation is disabled" >&2
  exit 126
fi
case "$(uname -r 2>/dev/null || true)" in
  *[Mm]icrosoft*)
    interop_cfg_ok="$(awk 'BEGIN{s=0;e=0;p=0} /^[[:space:]]*\[/{x=tolower($0);s=(x~/^[[:space:]]*\[interop\][[:space:]]*$/);next} s{x=tolower($0);gsub(/[[:space:]]/,"",x);if(x~/^enabled=false([#;].*)?$/)e=1;if(x~/^appendwindowspath=false([#;].*)?$/)p=1} END{if(e&&p)print "yes"}' /etc/wsl.conf 2>/dev/null || true)"
    if [ -n "${WSL_INTEROP:-}" ] || [ "$interop_cfg_ok" != "yes" ]; then
      echo "[codex-dsh] refusing agent exec: WSL interoperability is not fully disabled; set [interop] enabled=false and appendWindowsPath=false in /etc/wsl.conf, then restart WSL" >&2
      exit 126
    fi
    ;;
esac

if [ "$use_stdin" = "1" ]; then
  task="$(cat)"
else
  task="${task_args[*]}"
fi
if [ -z "$task" ]; then
  echo "[codex-dsh] empty task (no prompt positional and no stdin)" >&2
  exit 2
fi

# --- resolve model / effort for this call ------------------------------------
# Source of truth: the deployment dsh home. Per-call overrides only win when the
# argv names a deepseek-ish model, or an explicit DANUS_DSH_MODEL/EFFORT is set.
SRC_HOME="${DANUS_DSH_HOME:-$HOME/.dsh}"
provider=""
if [ -f "$SRC_HOME/settings.yaml" ]; then
  provider="$("$PY" "$DSH_PY" read-agent-default-key "$SRC_HOME/settings.yaml" provider || true)"
fi
provider="${provider:-${DANUS_DSH_PROVIDER:-deepseek-official}}"

model_sel="${DANUS_DSH_MODEL:-}"
if [ -z "$model_sel" ] && [ -n "$model_arg" ] && \
   case "$model_arg" in deepseek*|ds-*|dsh-*) true ;; *) false ;; esac; then
  model_sel="$model_arg"
fi
if [ -z "$model_sel" ] && [ -f "$SRC_HOME/settings.yaml" ]; then
  model_sel="$("$PY" "$DSH_PY" read-agent-default-key "$SRC_HOME/settings.yaml" model || true)"
fi
model_sel="${model_sel:-deepseek-v4-pro}"

effort_sel="${DANUS_DSH_EFFORT:-}"
if [ -z "$effort_sel" ]; then
  # DeepSeek's reasoning-effort enum is off | high | max (no low/medium tiers),
  # so the codex scale collapses onto it: anything below high -> high.
  case "${effort_arg:-}" in
    minimal|low|medium) effort_sel="high" ;;
    high)               effort_sel="high" ;;
    xhigh|max)          effort_sel="max" ;;
    *)                  effort_sel="" ;;
  esac
fi

# --- per-run DSH_HOME ---------------------------------------------------------
RT="${DANUS_RUNTIME:-$DANUS_ROOT/runtime}"
mkdir -p "$RT/dsh-runs"
RUN_HOME="$(mktemp -d "$RT/dsh-runs/run.XXXXXX")"
DSH_PID=""
cleanup() {
  if [ -n "${DSH_PID:-}" ]; then
    kill "$DSH_PID" 2>/dev/null || true
    wait "$DSH_PID" 2>/dev/null || true
    DSH_PID=""
  fi
  rm -rf "$RUN_HOME"
}
trap cleanup EXIT
trap 'exit 143' TERM INT
[ -f "$SRC_HOME/.credentials.yaml" ] && cp "$SRC_HOME/.credentials.yaml" "$RUN_HOME/" || true
[ -f "$SRC_HOME/settings.yaml" ] && cp "$SRC_HOME/settings.yaml" "$RUN_HOME/" || true
if [ -f "$RUN_HOME/.credentials.yaml" ]; then
  chmod 600 "$RUN_HOME/.credentials.yaml"
fi
if [ ! -f "$RUN_HOME/settings.yaml" ]; then
  printf 'agent-default-model:\n  provider: %s\n  model: %s\n' "$provider" "$model_sel" > "$RUN_HOME/settings.yaml"
fi

if [ -z "${DANUS_DSH_EFFORT:-}" ] && [ -z "${effort_arg:-}" ] && ! grep -q 'reasoningEffort' "$SRC_HOME/settings.yaml" 2>/dev/null; then
  effort_sel=""
fi

"$PY" "$DSH_PY" rewrite-settings "$RUN_HOME/settings.yaml" "$provider" "$model_sel" "$effort_sel"

# --- danus gateway MCP injection (headless has no codex -c) --------------------
GW_ROLE="worker"; GW_AUTHOR="$(basename "$PWD")"
GW_PROJECT="$(dirname "$(dirname "$PWD")")"; GW_FAIL="true"
if [ -z "${mcp_arg:-}" ] && [ -f "$PWD/.codex/config.toml" ]; then
  r="$("$PY" "$DSH_PY" read-worker-gateway-role "$PWD/.codex/config.toml" || true)"
  [ -n "$r" ] && GW_ROLE="$r"
fi
if [ -n "${mcp_arg:-}" ]; then
  r="$(printf '%s' "$mcp_arg" | sed -n 's/.*DANUS_ROLE="\([^"]*\)".*/\1/p')"
  [ -n "$r" ] && GW_ROLE="$r"
  a="$(printf '%s' "$mcp_arg" | sed -n 's/.*DANUS_AUTHOR="\([^"]*\)".*/\1/p')"
  [ -n "$a" ] && GW_AUTHOR="$a"
  GW_PROJECT=""
  GW_FAIL="false"
fi
mkdir -p "$RUN_HOME/profiles/headless"
cat > "$RUN_HOME/profiles/headless/package.json" <<JSON
{
  "name": "dsh-profile-headless",
  "private": true,
  "dependencies": {},
  "dsh": { "profile": { "bundles": ["@deepseek-ai/dsh-base", "@deepseek-ai/dsh-headless"] } }
}
JSON
"$PY" "$DSH_PY" write-gateway-patch \
  --out "$RUN_HOME/profiles/headless/cordis.patch.yml" \
  --role "$GW_ROLE" \
  --author "$GW_AUTHOR" \
  --project "$GW_PROJECT" \
  --fail "$GW_FAIL" \
  --root "$DANUS_ROOT" \
  --verify-url "${DANUS_VERIFY_URL:-http://127.0.0.1:8091/verify}"

# --- run one headless session; stdout + exit code pass through -----------------
echo "[codex-dsh] DSH_HOME=$RUN_HOME model=$model_sel effort=${effort_sel:-default} gateway_role=$GW_ROLE sandbox=$sandbox_arg" >&2
set +e
env DSH_HOME="$RUN_HOME" DSH_PERMISSION_MODE="$sandbox_arg" DSH_TOOLS_MODE="native" "${DANUS_DSH_NODE:-node}" "$DANUS_DSH_BIN" --profile headless "$task" &
DSH_PID=$!
wait "$DSH_PID"
rc=$?
set -e
DSH_PID=""
exit "$rc"
