#!/usr/bin/env bash
# codex worker-binary wrapper. The codex *binary* is @openai/codex, provisioned
# by scripts/bootstrap.sh; its exact path is written to runtime/runtime.env as
# DANUS_NODE / DANUS_CODEX_JS. This wrapper keeps a single codex version on the
# workers' PATH regardless of where it landed.
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$HERE/../scripts/env.sh" >/dev/null 2>&1
if [ -z "${DANUS_NODE:-}" ] || [ -z "${DANUS_CODEX_JS:-}" ]; then
  echo "codex not provisioned — run scripts/bootstrap.sh (sets DANUS_NODE/DANUS_CODEX_JS)" >&2
  exit 127
fi

if [ "${1:-}" = "exec" ]; then
  sandbox=""
  args=("$@")
  for ((i=0; i<${#args[@]}; i++)); do
    case "${args[$i]}" in
      --dangerously-bypass-approvals-and-sandbox|--full-auto)
        echo "codex exec refused: unrestricted/escalating execution is disabled by Danus-R" >&2
        exit 126
        ;;
      --sandbox)
        sandbox="${args[$((i+1))]:-}"
        if [ "$sandbox" = "danger-full-access" ]; then
          echo "codex exec refused: danger-full-access sandbox is disabled by Danus-R" >&2
          exit 126
        fi
        ;;
      --config|-c)
        value="${args[$((i+1))]:-}"
        case "$value" in
          sandbox_mode=*|approval_policy=danger-full-access)
            echo "codex exec refused: sandbox/approval escalation is disabled by Danus-R" >&2
            exit 126
            ;;
        esac
        ;;
    esac
  done
  case "$(uname -r 2>/dev/null || true)" in
    *[Mm]icrosoft*)
      interop_cfg_ok="$(awk 'BEGIN{s=0;e=0;p=0} /^[[:space:]]*\[/{x=tolower($0);s=(x~/^[[:space:]]*\[interop\][[:space:]]*$/);next} s{x=tolower($0);gsub(/[[:space:]]/,"",x);if(x~/^enabled=false([#;].*)?$/)e=1;if(x~/^appendwindowspath=false([#;].*)?$/)p=1} END{if(e&&p)print "yes"}' /etc/wsl.conf 2>/dev/null || true)"
      if [ -n "${WSL_INTEROP:-}" ] || [ "$interop_cfg_ok" != "yes" ]; then
        echo "codex exec refused: WSL interoperability is not fully disabled; set [interop] enabled=false and appendWindowsPath=false in /etc/wsl.conf, then restart WSL" >&2
        exit 126
      fi
      ;;
  esac
fi

exec "$DANUS_NODE" "$DANUS_CODEX_JS" "$@"
